# ==============================================================================
# CampusOS — Smart Campus Facility & Maintenance Platform
# Copy this file to `.env` for local or Docker Compose deployment:
#   cp .env.example .env
# NEVER commit `.env` or real Firebase credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Runtime Configuration (Backend Container)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Public URL where the app is accessed (e.g., http://localhost:3000 or
# https://<codespace-name>-3000.app.github.dev in GitHub Codespaces)
APP_URL=http://localhost:3000

# Optional CORS allowed origin (defaults to reflecting request origin when unset).
# In GitHub Codespaces, set to your forwarded HTTPS URL if accessed cross-origin.
CORS_ORIGIN=http://localhost:3000

# Optional initial Workspace Administrator email override (case-insensitive)
INITIAL_ADMIN_EMAIL=

# ------------------------------------------------------------------------------
# Server-Side Firebase Admin & Firestore Configuration (Runtime Secrets)
# ------------------------------------------------------------------------------
# Required: Your Firebase Project ID and Cloud Firestore Database ID
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_ID=(default)
FIREBASE_API_KEY=your-firebase-web-api-key

# Optional (Recommended for production Admin SDK operations):
# Provide EITHER an inline/base64 service account JSON string OR mount a read-only
# key file inside the container and set GOOGLE_APPLICATION_CREDENTIALS.
# Keep these blank to verify ID tokens via Google public certificates only.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# ------------------------------------------------------------------------------
# Client-Side Firebase Web SDK Configuration (Public App Config)
# ------------------------------------------------------------------------------
# Injected at runtime by server.ts into index.html (never baked into Docker image).
# Copy these values from Firebase Console -> Project Settings -> Your Apps (Web).
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_MEASUREMENT_ID=
